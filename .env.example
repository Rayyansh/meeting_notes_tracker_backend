# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

DB_PATH=db.sqlite3
DB_TIMEOUT_SECONDS=20

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_THROTTLE_RATE=10/min
REGISTER_THROTTLE_RATE=5/min

PAGINATION_COUNT=10
MAX_PAGE_SIZE=100
UPLOAD_MAX_BYTES=1048576

# mock (default, offline) or gemini
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=30
AI_MAX_TRANSCRIPT_CHARS=100000
# Only needed when AI_PROVIDER=gemini; put real values in your local .env only.
GEMINI_API_KEY=
GEMINI_MODEL=

LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=False
